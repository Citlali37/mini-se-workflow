  {
    "id": "ledger",
    "category": "normal",
    "task": "开发本地支出记账工具，数据JSON持久保存。请求action:add包含正整数amount（以分计，布尔值非法）及非空字符串category（去除首尾空白），返回ok:true,entry:{amount,category}；action:list返回ok:true,entries数组（创建顺序）；action:total返回ok:true,total（总金额整数，初始0）。非法金额返回ok:false,error:\"invalid_amount\"，非法分类返回ok:false,error:\"invalid_category\"，未知操作返回ok:false,error:\"unknown_action\"。每请求重启进程。",
    "expected": "project",
    "checks": [
      {
        "id": "L1",
        "description": "持久化和总金额",
        "source": "independent",
        "steps": [
          {
            "input": {
              "action": "total"
            },
            "expected": {
              "ok": true,
              "total": 0
            }
          },
          {
            "input": {
              "action": "add",
              "amount": 125,
              "category": " 餐饮 "
            },
            "expected": {
              "ok": true,
              "entry": {
                "amount": 125,
                "category": "餐饮"
              }
            }
          },
          {
            "input": {
              "action": "add",
              "amount": 75,
              "category": "交通"
            },
            "expected": {
              "ok": true
            }
          },
          {
            "input": {
              "action": "list"
            },
            "expected": {
              "ok": true,
              "entries": [
                {
                  "amount": 125,
                  "category": "餐饮"
                },
                {
                  "amount": 75,
                  "category": "交通"
                }
              ]
            }
          },
          {
            "input": {
              "action": "total"
            },
            "expected": {
              "ok": true,
              "total": 200
            }
          }
        ]
      },
      {
        "id": "L2",
        "description": "非法请求不改变数据",
        "source": "independent",
        "steps": [
          {
            "input": {
              "action": "add",
              "amount": true,
              "category": "餐饮"
            },
            "expected": {
              "ok": false,
              "error": "invalid_amount"
            }
          },
          {
            "input": {
              "action": "add",
              "amount": 1,
              "category": " "
            },
            "expected": {
              "ok": false,
              "error": "invalid_category"
            }
          },
          {
            "input": {
              "action": "wat"
            },
            "expected": {
              "ok": false,
              "error": "unknown_action"
            }
          },
          {
            "input": {
              "action": "total"
            },
            "expected": {
              "ok": true,
              "total": 0
            }
          }
        ]
      }
    ]
  },
