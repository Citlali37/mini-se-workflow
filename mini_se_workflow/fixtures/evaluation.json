[
  {
    "id": "todo",
    "category": "normal",
    "task": "开发一个待办事项工具：支持新增、查看、完成和删除任务；使用本地 JSON 文件保存，重启后数据不丢失；任务编号从1递增且不复用，标题去除首尾空白，空标题和非文本标题都应拒绝。JSON 请求使用 action 字段：add 携带 title，list 查看列表，complete/delete 携带正整数 id（布尔值不算整数）。新增和完成成功返回 ok:true,task:{id,title,completed}；查看返回 ok:true,tasks 数组（按创建顺序）；删除返回 ok:true,deleted_id。新任务 completed 为 false，完成后为 true。失败返回 ok:false,error：空白或非文本标题为 empty_title，非法编号为 invalid_id，不存在的任务为 not_found，未知操作为 unknown_action。",
    "expected": "project",
    "checks": [
      {
        "id": "B1",
        "requirement_ids": [],
        "description": "中文标题去除空白；多个任务按顺序保存",
        "steps": [
          {
            "input": {
              "action": "add",
              "title": "  完成课程作业  "
            },
            "expected": {
              "task": {
                "id": 1,
                "title": "完成课程作业"
              }
            }
          },
          {
            "input": {
              "action": "add",
              "title": "复习"
            },
            "expected": {
              "task": {
                "id": 2
              }
            }
          },
          {
            "input": {
              "action": "list"
            },
            "expected": {
              "ok": true,
              "tasks": [
                {
                  "id": 1,
                  "title": "完成课程作业",
                  "completed": false
                },
                {
                  "id": 2,
                  "title": "复习",
                  "completed": false
                }
              ]
            }
          }
        ],
        "source": "independent"
      },
      {
        "id": "B2",
        "requirement_ids": [],
        "description": "拒绝纯空白与非文本标题",
        "steps": [
          {
            "input": {
              "action": "add",
              "title": " \t "
            },
            "expected": {
              "ok": false,
              "error": "empty_title"
            }
          },
          {
            "input": {
              "action": "add",
              "title": 123
            },
            "expected": {
              "ok": false,
              "error": "empty_title"
            }
          },
          {
            "input": {
              "action": "list"
            },
            "expected": {
              "tasks": []
            }
          }
        ],
        "source": "independent"
      },
      {
        "id": "B3",
        "requirement_ids": [],
        "description": "布尔值不能冒充任务编号",
        "steps": [
          {
            "input": {
              "action": "add",
              "title": "保持未完成"
            },
            "expected": {
              "ok": true
            }
          },
          {
            "input": {
              "action": "complete",
              "id": true
            },
            "expected": {
              "ok": false,
              "error": "invalid_id"
            }
          },
          {
            "input": {
              "action": "list"
            },
            "expected": {
              "tasks": [
                {
                  "id": 1,
                  "completed": false
                }
              ]
            }
          }
        ],
        "source": "independent"
      },
      {
        "id": "B4",
        "requirement_ids": [],
        "description": "未知操作与删除不存在的任务",
        "steps": [
          {
            "input": {
              "action": "unknown"
            },
            "expected": {
              "ok": false,
              "error": "unknown_action"
