  {
    "id": "text-stats",
    "category": "boundary",
    "task": "开发一个文本统计工具。每次从标准输入接收 JSON 对象，包含 text 字段，统计并返回：包含空格和换行的总字符数 characters；连续 ASCII 字母或数字组成的英文单词数 words（例如 hello-world 是2个词）；按 splitlines() 计算的行数 lines（空字符串为0行）。正常输出包含 ok:true 和这三个整数。空文本应成功返回三个0。text 缺失或不是字符串时返回 ok:false,error:\"invalid_text\"。不需要保存数据，也不需要联网。请提供中文、英文、空文本、换行和无效输入的验收用例。\n",
    "expected": "project",
    "checks": [
      {
        "id": "S1",
        "description": "混合文本和连字符",
        "source": "independent",
        "steps": [
          {
            "input": {
              "text": "你好 hello-world 123"
            },
            "expected": {
              "ok": true,
              "characters": 18,
              "words": 3,
              "lines": 1
            }
          }
        ]
      },
      {
        "id": "S2",
        "description": "空文本",
        "source": "independent",
        "steps": [
          {
            "input": {
              "text": ""
            },
            "expected": {
              "ok": true,
              "characters": 0,
              "words": 0,
              "lines": 0
            }
          }
        ]
      },
      {
        "id": "S3",
        "description": "Unicode 换行及下划线",
        "source": "independent",
        "steps": [
          {
            "input": {
              "text": "a_b 中"
            },
            "expected": {
              "ok": true,
              "characters": 5,
              "words": 2,
              "lines": 2
            }
          }
        ]
      },
      {
        "id": "S4",
        "description": "布尔值、数组及缺少字段",
        "source": "independent",
        "steps": [
          {
            "input": {
              "text": true
            },
            "expected": {
              "ok": false,
              "error": "invalid_text"
            }
          },
          {
            "input": {
              "text": []
            },
            "expected": {
              "ok": false,
              "error": "invalid_text"
            }
          },
          {
            "input": {},
            "expected": {
              "ok": false,
              "error": "invalid_text"
            }
          }
        ]
      }
    ]
  },
