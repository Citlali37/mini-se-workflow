[
  {
    "id": "C1",
    "group": "original",
    "source": "independent",
    "description": "重复编号不覆盖原值、跨闰月应还日期",
    "steps": [
      {
        "input": {
          "action": "add_book",
          "book_id": "B1",
          "title": "书A",
          "total_copies": 2
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_reader",
          "reader_id": "R1",
          "name": "R1"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_book",
          "book_id": "B1",
          "title": "错误覆盖",
          "total_copies": 8
        },
        "expected": {
          "ok": false,
          "error": "duplicate_book_id"
        },
        "preserve_files": [
          "library_data.json"
        ]
      },
      {
        "input": {
          "action": "add_reader",
          "reader_id": "R1",
          "name": "覆盖"
        },
        "expected": {
          "ok": false,
          "error": "duplicate_reader_id"
        },
        "preserve_files": [
          "library_data.json"
        ]
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B1",
          "reader_id": "R1",
          "borrow_date": "2024-02-28"
        },
        "expected": {
          "ok": true,
          "available_copies": 1,
          "record": {
            "due_date": "2024-03-13",
            "returned": false
          }
        }
      }
    ]
  },
  {
    "id": "C2",
    "group": "original",
    "source": "independent",
    "description": "库存耗尽不写入，其他读者不能借出",
    "steps": [
      {
        "input": {
          "action": "add_book",
          "book_id": "B1",
          "title": "书A",
          "total_copies": 1
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_reader",
          "reader_id": "R1",
          "name": "R1"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_reader",
          "reader_id": "R2",
          "name": "R2"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B1",
          "reader_id": "R1",
          "borrow_date": "2024-02-28"
        },
        "expected": {
          "ok": true,
          "available_copies": 0
        }
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B1",
          "reader_id": "R2",
          "borrow_date": "2024-03-01"
        },
        "expected": {
          "ok": false,
          "error": "no_copies_available"
        },
        "preserve_files": [
          "library_data.json"
        ]
      },
      {
        "input": {
          "action": "list_borrowed",
          "reader_id": "R2"
        },
        "expected": {
          "ok": true,
          "borrows": []
        }
      }
    ]
  },
  {
    "id": "C3",
    "group": "original",
    "source": "independent",
    "description": "重复借阅、重复归还拒绝，归还后可再次借出",
    "steps": [
      {
        "input": {
          "action": "add_book",
          "book_id": "B1",
          "title": "书A",
          "total_copies": 2
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_reader",
          "reader_id": "R1",
          "name": "R1"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B1",
          "reader_id": "R1",
          "borrow_date": "2024-02-28"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B1",
          "reader_id": "R1",
          "borrow_date": "2024-03-01"
        },
        "expected": {
          "ok": false,
          "error": "already_borrowed"
        },
        "preserve_files": [
          "library_data.json"
        ]
      },
      {
        "input": {
          "action": "return_book",
          "book_id": "B1",
          "reader_id": "R1",
          "return_date": "2024-03-02"
        },
        "expected": {
          "ok": true,
          "available_copies": 2
        }
      },
      {
        "input": {
          "action": "return_book",
          "book_id": "B1",
          "reader_id": "R1",
          "return_date": "2024-03-03"
        },
        "expected": {
          "ok": false,
          "error": "not_borrowed"
        },
        "preserve_files": [
          "library_data.json"
        ]
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B1",
          "reader_id": "R1",
          "borrow_date": "2024-03-04"
        },
        "expected": {
          "ok": true
        }
      }
    ]
  },
  {
    "id": "C4",
    "group": "original",
    "source": "independent",
    "description": "应还当日不逾期，次日逾期且按读者过滤",
    "steps": [
      {
        "input": {
          "action": "add_book",
          "book_id": "B1",
          "title": "书A",
          "total_copies": 2
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_reader",
          "reader_id": "R1",
          "name": "R1"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_reader",
          "reader_id": "R2",
          "name": "R2"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B1",
          "reader_id": "R1",
          "borrow_date": "2024-02-28"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "list_overdue",
          "date": "2024-03-13"
        },
        "expected": {
          "ok": true,
          "overdue": []
        }
      },
      {
        "input": {
          "action": "list_overdue",
          "date": "2024-03-14"
        },
        "expected": {
          "ok": true,
          "overdue": [
            {
              "book_id": "B1",
              "reader_id": "R1",
              "due_date": "2024-03-13"
            }
          ]
        }
      },
      {
        "input": {
          "action": "list_overdue",
          "date": "2024-03-14",
          "reader_id": "R2"
        },
        "expected": {
          "ok": true,
          "overdue": []
        }
      }
    ]
  },
  {
    "id": "C5",
    "group": "original",
    "source": "independent",
    "description": "不同图书互不影响，跨进程保持借阅顺序",
    "steps": [
      {
        "input": {
          "action": "add_book",
          "book_id": "B2",
          "title": "书B",
          "total_copies": 2
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_book",
          "book_id": "B1",
          "title": "书A",
          "total_copies": 1
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "add_reader",
          "reader_id": "R1",
          "name": "R1"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B2",
          "reader_id": "R1",
          "borrow_date": "2024-02-28"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "borrow",
          "book_id": "B1",
          "reader_id": "R1",
          "borrow_date": "2024-02-28"
        },
        "expected": {
          "ok": true
        }
      },
      {
        "input": {
          "action": "list_borrowed",
          "reader_id": "R1"
        },
        "expected": {
          "ok": true,
          "borrows": [
            {
              "book_id": "B2",
              "title": "书B"
            },
            {
              "book_id": "B1",
              "title": "书A"
            }
          ]
        }
      }
    ]
  },
